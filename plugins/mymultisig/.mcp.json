{
  "mcpServers": {
    "mymultisig": {
      "command": "npx",
      "args": ["-y", "mymultisig-mcp@0.1.3"],
      "env": {
        "CLAUDE_PLUGIN_OPTION_API_KEY": "${user_config.api_key}",
        "CLAUDE_PLUGIN_OPTION_PRIVATE_KEY": "${user_config.private_key}",
        "CLAUDE_PLUGIN_OPTION_CHAINS": "${user_config.chains}",
        "CLAUDE_PLUGIN_OPTION_READ_ONLY": "${user_config.read_only}"
      }
    }
  }
}
