{
  "mcpServers": {
    "mymultisig": {
      "command": "npx",
      "args": ["-y", "mymultisig-mcp@0.1"],
      "env": {
        "MYMULTISIG_API_KEY": "${MYMULTISIG_API_KEY:-}",
        "MYMULTISIG_PRIVATE_KEY": "${MYMULTISIG_PRIVATE_KEY:-}",
        "MYMULTISIG_API_URL": "${MYMULTISIG_API_URL:-https://mymultisig.app}",
        "MYMULTISIG_CHAINS": "${MYMULTISIG_CHAINS:-}",
        "MYMULTISIG_READ_ONLY": "${MYMULTISIG_READ_ONLY:-}"
      }
    }
  }
}
