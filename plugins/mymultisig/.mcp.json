{
  "mcpServers": {
    "mymultisig": {
      "command": "npx",
      "args": ["-y", "mymultisig-mcp@0.1.1"],
      "env": {
        "MYMULTISIG_API_KEY": "${user_config.api_key}",
        "MYMULTISIG_PRIVATE_KEY": "${user_config.private_key}",
        "MYMULTISIG_CHAINS": "${user_config.chains}",
        "MYMULTISIG_READ_ONLY": "${user_config.read_only}"
      }
    }
  }
}
