  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "mms_ API key",
        "description": "Scoped API key from /settings/agents"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "siwe-session",
        "description": "SIWE session from POST /api/siwe/verify"
      }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "ApiKeyScope": {
        "type": "string",
        "enum": ["read", "propose", "sign", "manage"]
      },
      "ApiKeyInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "keyPrefix": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiKeyScope"
            }
          },
          "walletAddresses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "lastUsedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "expiresAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "revokedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      },
      "RequestPayload": {
        "type": "object",
        "required": ["to", "value", "data", "txnGas", "signatures"],
        "description": "Arguments of the wallet's execTransaction. Signers sign the EIP-712 struct Transaction(to, value, data, gas, nonce[, validUntil][, operation]) with domain {name: wallet.name(), version: wallet.version(), chainId, verifyingContract: wallet}.",
        "properties": {
          "to": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "value": {
            "type": "string",
            "description": "wei, decimal"
          },
          "data": {
            "type": "string"
          },
          "txnGas": {
            "type": "string",
            "description": "gas forwarded to the inner call"
          },
          "signatures": {
            "type": "string",
            "description": "Combined blob: concatenated 65-byte sigs (< 0.5.0) or abi.encode((address owner, bytes sig)[]) (>= 0.5.0)"
          },
          "txnNonce": {
            "type": "string",
            "description": "Extended wallets: pinned nonce"
          },
          "validUntil": {
            "type": "string",
            "description": "0.5.0: unix seconds, 0 = no expiry"
          },
          "operation": {
            "type": "string",
            "enum": ["0", "1"],
            "description": "0.5.0 Extended: 1 = DELEGATECALL"
          },
          "mode": {
            "type": "string",
            "enum": ["standard", "userop"]
          },
          "executionTxHash": {
            "type": "string"
          }
        }
      },
      "MultiSigRequest": {
        "type": "object",
        "required": ["id", "multiSigAddress", "request", "description", "submitter", "signatures", "ownerSigners"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "multiSigAddress": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "request": {
            "$ref": "#/components/schemas/RequestPayload"
          },
          "description": {
            "type": "string"
          },
          "submitter": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "signatures": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Individual signatures, parallel to ownerSigners"
          },
          "ownerSigners": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          },
          "dateSubmitted": {
            "type": "string"
          },
          "dateExecuted": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "isExecuted": {
            "type": "boolean"
          },
          "isCancelled": {
            "type": "boolean"
          },
          "isConfirmed": {
            "type": "boolean"
          },
          "isSuccessful": {
            "type": "boolean"
          },
          "txnNonce": {
            "type": ["string", "null"]
          },
          "dateCancelled": {
            "type": "string"
          },
          "cancelledBy": {
            "type": "string"
          }
        }
      },
      "MultiSigWallet": {
        "type": "object",
        "properties": {
          "chainId": {
            "type": "integer"
          },
          "chainName": {
            "type": "string"
          },
          "factoryAddress": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "threshold": {
            "type": "integer"
          },
          "ownerCount": {
            "type": "integer"
          },
          "nonce": {
            "type": "integer"
          },
          "owners": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          },
          "isDeployed": {
            "type": "boolean"
          },
          "walletType": {
            "type": "string",
            "enum": ["simple", "extended", "advanced"]
          },
          "allowOnlyOwnerRequest": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
