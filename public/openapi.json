      "post": {
        "summary": "Upsert an address book entry",
        "tags": ["address-book"],
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": []
          }
        ],
        "x-required-scope": "manage",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
