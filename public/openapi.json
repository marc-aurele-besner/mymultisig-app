        }
      }
    },
    "/api/get-assets": {
      "post": {
        "summary": "ERC-20 and NFT holdings of an address (via the app's indexer)",
        "tags": ["assets"],
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
