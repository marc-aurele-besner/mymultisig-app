# Public (client) variables
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_INFURA_API_KEY=
NEXT_PUBLIC_APP_GTAG=

# ERC-4337 bundler + paymaster URLs (per-chain override or global fallback).
# Per-chain wins; the global fallback is used when no per-chain URL is set.
# Examples:
#   NEXT_PUBLIC_BUNDLER_URL_11155111=https://api.pimlico.io/v2/sepolia/rpc?api-key=YOUR_KEY
#   NEXT_PUBLIC_PAYMASTER_URL_11155111=https://api.pimlico.io/v2/sepolia/rpc?api-key=YOUR_KEY
NEXT_PUBLIC_BUNDLER_URL=
NEXT_PUBLIC_PAYMASTER_URL=

# Server-only variables
DATABASE_URL=
ETHERSCAN_API_KEY=
# Token/NFT balances on the Assets tab (falls back to NEXT_PUBLIC_ALCHEMY_API_KEY)
ALCHEMY_API_KEY=
# Comma-separated wallet addresses allowed to view the public address book (/admin)
ADMIN_ADDRESSES=
PRIVATE_KEY=
RPC_ETHEREUM=

# Slack app — see docs/slack-integration.md for setup.
# Generate SLACK_TOKEN_ENCRYPTION_KEY with: openssl rand -base64 32
# (must decode to exactly 32 bytes)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_TOKEN_ENCRYPTION_KEY=
# Optional. When unset, the install handler builds the redirect URI from
# the request host. Set this when deploying behind a proxy or with a
# custom domain that the host header doesn't reflect.
# SLACK_REDIRECT_URI=https://mymultisig.app/api/slack/oauth-callback

# Discord app — see docs/discord-integration.md for setup.
# Generate DISCORD_TOKEN_ENCRYPTION_KEY with: openssl rand -base64 32
# (must decode to exactly 32 bytes). DISCORD_PUBLIC_KEY is the Ed25519
# public key from the application's General Information page; paste the
# hex value (with or without the 0x prefix — both are accepted).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_TOKEN_ENCRYPTION_KEY=
# Optional. When unset, the install handler builds the redirect URI from
# the request host. Set this when deploying behind a proxy or with a
# custom domain that the host header doesn't reflect.
# DISCORD_REDIRECT_URI=https://mymultisig.app/api/discord/oauth-callback

# Telegram bot — see docs/telegram-integration.md for setup.
# Generate TELEGRAM_TOKEN_ENCRYPTION_KEY with: openssl rand -base64 32
# (must decode to exactly 32 bytes). The same key encrypts the bot token
# AND the per-install webhook secret at rest. Telegram has no OAuth; the
# user pastes the @BotFather token into /settings/telegram instead.
TELEGRAM_TOKEN_ENCRYPTION_KEY=
# Optional. Defaults to https://api.telegram.org — override only for tests.
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# Contact form (Resend)
RESEND_API_KEY=
RESEND_CONTACT_TO=
# Optional; defaults to "MyMultiSig <onboarding@resend.dev>". Use an address on a domain verified in Resend.
RESEND_FROM=

# NextAuth (optional)
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=
DISCORD_ID=
DISCORD_SECRET=
TWITTER_ID=
TWITTER_SECRET=
SLACK_ID=
SLACK_SECRET=